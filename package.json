    "name": "road-to-next-ts",
    "private": true,
    "scripts": {
        "biome:lint": "npx @biomejs/biome check ./src",
        "build": "tsc -b && vite build",
        "dev": "vite",
        "format:css": "npx prettier --write \"src/**/*.css\"",
